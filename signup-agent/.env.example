# The agent's key. Make it at https://pidgeon.ai/app/developers/keys with Admin
# access. It always reaches the addresses it creates, so in a workspace that
# holds other mail, give it one address rather than every address.
PIDGEON_API_KEY=pgn_live_...

# The demo site's key: it can send from the site's own address and nothing
# else. `python site/sender.py` makes both and fills this in.
SITE_PIDGEON_API_KEY=

# The model. Claude by default; set OPENAI_API_KEY instead to use OpenAI.
ANTHROPIC_API_KEY=
